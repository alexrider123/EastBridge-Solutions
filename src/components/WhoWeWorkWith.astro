---
import type { Translation } from '../i18n/en';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<section id="who-we-work-with" class="section who-section">
  <div class="container">
    <div class="who-layout">

      <div class="who-header">
        <span class="section-label">{t.whoWeWork.label}</span>
        <h2 class="section-headline">{t.whoWeWork.headline}</h2>
        <div class="divider"></div>
        <p class="who-intro">{t.whoWeWork.intro}</p>
        <p class="who-note">{t.whoWeWork.note}</p>
        <p class="who-closing">{t.whoWeWork.closing}</p>
      </div>

      <div class="sector-list">
        {t.whoWeWork.sectors.map((sector, i) => (
          <div class="sector-row">
            <span class="sector-num" aria-hidden="true">0{i + 1}</span>
            <div class="sector-content">
              <p class="sector-title">{sector.title}</p>
              <p class="sector-body">{sector.body}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .who-section {
    background-color: var(--color-warm-gray);
  }

  /* ── Layout ── */
  .who-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  @media (min-width: 681px) {
    .who-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
      align-items: start;
    }

    .who-header {
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
    }
  }

  /* ── Left column: header + text ── */
  .who-header {
    max-width: 520px;
  }

  .who-intro {
    font-size: 0.92rem;
    color: var(--color-text-body);
    line-height: 1.75;
  }

  :lang(zh) .who-intro {
    font-family: var(--font-zh-sans);
  }

  .who-note {
    margin-top: var(--space-4);
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--color-text-body);
  }

  :lang(zh) .who-note {
    font-family: var(--font-zh-sans);
  }

  .who-closing {
    margin-top: var(--space-4);
    font-size: 0.88rem;
    line-height: 1.72;
    color: var(--color-text-muted);
    font-style: italic;
  }

  :lang(zh) .who-closing {
    font-family: var(--font-zh-sans);
  }

  /* ── Right column: sector list ── */
  .sector-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  .sector-row {
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: start;
    gap: var(--space-5);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .sector-num {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-gold);
    opacity: 0.8;
    line-height: 1.6;
    padding-top: 2px; /* align with title baseline */
    user-select: none;
    flex-shrink: 0;
  }

  .sector-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sector-title {
    font-family: var(--font-serif);
    font-size: 0.97rem;
    font-weight: 600;
    color: var(--color-navy);
    line-height: 1.4;
    margin: 0;
  }

  :lang(zh) .sector-title {
    font-family: var(--font-zh-serif);
  }

  .sector-body {
    font-size: 0.88rem;
    line-height: 1.72;
    color: var(--color-text-muted);
    margin: 0;
  }

  :lang(zh) .sector-body {
    font-family: var(--font-zh-sans);
  }

  /* ── Mobile ── */
  @media (max-width: 680px) {
    .sector-row {
      grid-template-columns: 36px 1fr;
      gap: var(--space-4);
    }
  }
</style>
