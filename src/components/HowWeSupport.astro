---
import type { Translation } from '../i18n/en';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const numbers = ['01', '02', '03', '04'];
---

<section id="services" class="section services-section">
  <div class="container">
    <div class="services-header">
      <span class="section-label">{t.services.label}</span>
      <h2 class="section-headline">{t.services.headline}</h2>
      <div class="services-divider"></div>
      <p class="services-intro">{t.services.intro}</p>
    </div>

    <div class="services-mobile-flow" data-services-flow>
      <div class="mobile-section-bar" aria-hidden="true">
        <span class="mobile-bar-label">{t.services.label}</span>
        <span class="mobile-bar-counter" data-mobile-counter>01 / 0{t.services.items.length}</span>
      </div>

      <div class="services-grid" data-services-grid>
        {t.services.items.map((item, i) => (
          <div class="service-card">
            <span class="service-number" aria-hidden="true">{numbers[i]}</span>
            <div class="card-mobile-top">
              <span class="card-counter" aria-hidden="true">{numbers[i]} / 0{t.services.items.length}</span>
            </div>
            <div class="card-rule"></div>
            <h3 class="service-title">{item.title}</h3>
            <p class="service-body">{item.body}</p>
            <div class="card-pips" aria-hidden="true">
              {t.services.items.map((_, j) => (
                <span class={`card-pip${j === i ? ' is-current' : ''}`}></span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="services-mobile-steps" aria-hidden="true">
        {t.services.items.map((_, i) => (
          <div class="services-mobile-step" data-step-index={String(i)}></div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const flow = document.querySelector<HTMLElement>('[data-services-flow]');
  if (flow) {
    const mobileQuery = window.matchMedia('(max-width: 640px)');
    const cards = Array.from(flow.querySelectorAll<HTMLElement>('.service-card'));
    const grid = flow.querySelector<HTMLElement>('[data-services-grid]');
    const steps = Array.from(flow.querySelectorAll<HTMLElement>('.services-mobile-step'));
    const section = flow.closest<HTMLElement>('.services-section');
    const lastIndex = cards.length - 1;
    const WHEEL_IDLE_MS = 300;
    const COOLDOWN_MS = 700;
    let currentIndex = 0;
    let lastTransitionAt = 0;
    let enteringTimer: number | null = null;
    let releaseDirection = 0;
    let passThroughDirection = 0;
    let isFlowCaptured = false;
    let anchorY: number[] = [];
    let wheelGestureActive = false;
    let wheelGestureConsumes = false;
    let wheelGestureTimer: number | null = null;
    let touchStartY = 0;
    let touchLastY = 0;
    let touchHandled = false;
    let touchShouldBlock = false;
    let touchInZone = false;
    let listenersAttached = false;
    const mobileCounter = flow.querySelector<HTMLElement>('[data-mobile-counter]');

    const headerOffset = () => {
      const styles = getComputedStyle(document.documentElement);
      const headerHeight = Number.parseFloat(styles.getPropertyValue('--header-height')) || 70;
      const topGap = Number.parseFloat(styles.getPropertyValue('--space-6')) || 24;
      return headerHeight + topGap;
    };

    const clearEntering = () => {
      if (enteringTimer) {
        window.clearTimeout(enteringTimer);
        enteringTimer = null;
      }
      cards.forEach((card) => card.classList.remove('is-entering'));
    };

    const clearWheelGesture = () => {
      wheelGestureActive = false;
      wheelGestureConsumes = false;
      if (wheelGestureTimer) {
        window.clearTimeout(wheelGestureTimer);
        wheelGestureTimer = null;
      }
    };

    const keepWheelGestureAlive = () => {
      if (wheelGestureTimer) window.clearTimeout(wheelGestureTimer);
      wheelGestureTimer = window.setTimeout(() => {
        clearWheelGesture();
      }, WHEEL_IDLE_MS);
    };

    const updateFlowHeight = (index: number) => {
      if (!cards[index]) return;
      const nextHeight = Math.max(Math.ceil(cards[index].scrollHeight), 240);
      flow.style.setProperty('--mobile-card-height', `${nextHeight}px`);
    };

    const updateAnchors = () => {
      const flowTop = flow.getBoundingClientRect().top + window.scrollY;
      anchorY = steps.map((step) => flowTop + step.offsetTop);
    };

    const scrollToCardStep = (index: number) => {
      if (!anchorY[index] && anchorY[index] !== 0) return;
      window.scrollTo({
        top: anchorY[index],
        behavior: 'auto',
      });
    };

    const setCardState = (nextIndex: number) => {
      const now = Date.now();
      if (now - lastTransitionAt < COOLDOWN_MS) return false;
      if (nextIndex < 0 || nextIndex >= cards.length || nextIndex === currentIndex) return false;

      clearEntering();
      updateFlowHeight(nextIndex);
      updateAnchors();

      cards.forEach((card, i) => {
        card.classList.toggle('is-active', i === nextIndex);
        card.classList.toggle('is-before', i < nextIndex);
        card.classList.toggle('is-after', i > nextIndex);
        card.setAttribute('aria-hidden', i === nextIndex ? 'false' : 'true');
      });
      cards[nextIndex].classList.add('is-entering');
      enteringTimer = window.setTimeout(() => {
        cards[nextIndex].classList.remove('is-entering');
      }, 440);

      currentIndex = nextIndex;
      lastTransitionAt = Date.now();
      if (mobileCounter) {
        const n = nextIndex + 1;
        mobileCounter.textContent = `0${n} / 0${cards.length}`;
      }
      return true;
    };

    const setInitialMobileState = () => {
      clearEntering();
      currentIndex = 0;
      lastTransitionAt = 0;
      updateFlowHeight(0);
      updateAnchors();
      cards.forEach((card, i) => {
        card.classList.toggle('is-active', i === 0);
        card.classList.toggle('is-before', false);
        card.classList.toggle('is-after', i > 0);
        card.setAttribute('aria-hidden', i === 0 ? 'false' : 'true');
      });
      if (mobileCounter) mobileCounter.textContent = `01 / 0${cards.length}`;
    };

    const inTrapZone = () => {
      if (!mobileQuery.matches || !section || !grid) return false;
      const sectionRect = section.getBoundingClientRect();
      const top = headerOffset();
      return sectionRect.top <= top && sectionRect.bottom >= top + grid.offsetHeight + 8;
    };

    const processDirection = (dir: number): 'consumed' | 'allow' => {
      if (!inTrapZone()) {
        releaseDirection = 0;
        passThroughDirection = 0;
        isFlowCaptured = false;
        return 'allow';
      }

      if (passThroughDirection !== 0) {
        if (dir === passThroughDirection) {
          return 'allow';
        }
        passThroughDirection = 0;
      }

      if (!isFlowCaptured) {
        isFlowCaptured = true;
        if (!mobileQuery.matches) {
          // Desktop only: first gesture snaps viewport to card, no advance yet
          updateAnchors();
          scrollToCardStep(currentIndex);
          return 'consumed';
        }
        // Mobile: fall through — first swipe advances immediately
      }

      if (releaseDirection !== 0 && dir !== releaseDirection) {
        releaseDirection = 0;
      }

      if (dir > 0 && currentIndex < lastIndex) {
        const changed = setCardState(currentIndex + 1);
        if (changed) {
          scrollToCardStep(currentIndex);
        }
        releaseDirection = 0;
        passThroughDirection = 0;
        return 'consumed';
      }
      if (dir < 0 && currentIndex > 0) {
        const changed = setCardState(currentIndex - 1);
        if (changed) {
          scrollToCardStep(currentIndex);
        }
        releaseDirection = 0;
        passThroughDirection = 0;
        return 'consumed';
      }

      if (releaseDirection === dir) {
        releaseDirection = 0;
        passThroughDirection = dir;
        return 'allow';
      }

      releaseDirection = dir;
      passThroughDirection = 0;
      return 'consumed';
    };

    const onWheel = (event: WheelEvent) => {
      if (Math.abs(event.deltaY) < 4) return;

      // On mobile, wheel events are iOS/Android scroll momentum — not intentional gestures.
      // Touch events handle card navigation with a one-gesture-one-advance guarantee.
      // Here we only preventDefault to prevent page jitter in the trap zone.
      if (mobileQuery.matches) {
        if (inTrapZone()) event.preventDefault();
        return;
      }

      const dir = event.deltaY > 0 ? 1 : -1;

      if (!wheelGestureActive) {
        wheelGestureActive = true;
        const outcome = processDirection(dir);
        wheelGestureConsumes = outcome === 'consumed';
      }

      if (wheelGestureConsumes) {
        event.preventDefault();
      }
      keepWheelGestureAlive();
    };

    const onTouchStart = (event: TouchEvent) => {
      if (!mobileQuery.matches) return;
      touchStartY = event.touches[0]?.clientY ?? 0;
      touchLastY = touchStartY;
      touchHandled = false;
      touchShouldBlock = false;
      touchInZone = inTrapZone(); // decide NOW before any page movement
    };

    const onTouchMove = (event: TouchEvent) => {
      if (!touchInZone) return;

      if (touchHandled) {
        // Direction already decided — only block if we determined to consume this gesture.
        if (touchShouldBlock) event.preventDefault();
        return;
      }

      const currentY = event.touches[0]?.clientY ?? touchStartY;
      touchLastY = currentY;
      const delta = touchStartY - currentY;

      if (Math.abs(delta) < 8) {
        // Direction undecided — block for now so we preserve the ability to preventDefault.
        event.preventDefault();
        return;
      }

      const dir = delta > 0 ? 1 : -1;
      const outcome = processDirection(dir);
      touchHandled = true;
      touchShouldBlock = outcome !== 'allow';
      if (touchShouldBlock) event.preventDefault();
    };

    const onTouchEnd = () => {
      touchHandled = false;
      touchShouldBlock = false;
      touchStartY = touchLastY;
    };

    const onResize = () => {
      if (!mobileQuery.matches) return;
      updateFlowHeight(currentIndex);
      updateAnchors();
    };

    const enableMobileFlow = () => {
      if (flow.classList.contains('is-mobile-flow') || cards.length === 0) return;

      flow.classList.add('is-mobile-flow');
      setInitialMobileState();
      if (listenersAttached) return;

      window.addEventListener('wheel', onWheel, { passive: false });
      window.addEventListener('touchstart', onTouchStart, { passive: true });
      window.addEventListener('touchmove', onTouchMove, { passive: false });
      window.addEventListener('touchend', onTouchEnd, { passive: true });
      window.addEventListener('resize', onResize, { passive: true });
      listenersAttached = true;
      requestAnimationFrame(() => updateFlowHeight(currentIndex));
      requestAnimationFrame(updateAnchors);
    };

    const disableMobileFlow = () => {
      if (listenersAttached) {
        window.removeEventListener('wheel', onWheel);
        window.removeEventListener('touchstart', onTouchStart);
        window.removeEventListener('touchmove', onTouchMove);
        window.removeEventListener('touchend', onTouchEnd);
        window.removeEventListener('resize', onResize);
        listenersAttached = false;
      }
      clearEntering();
      releaseDirection = 0;
      passThroughDirection = 0;
      isFlowCaptured = false;
      clearWheelGesture();
      touchHandled = false;
      touchShouldBlock = false;
      flow.classList.remove('is-mobile-flow');
      flow.style.removeProperty('--mobile-card-height');
      cards.forEach((card) => {
        card.classList.remove('is-active', 'is-before', 'is-after');
        card.removeAttribute('aria-hidden');
      });
    };

    const syncMode = () => {
      if (mobileQuery.matches) {
        enableMobileFlow();
      } else {
        disableMobileFlow();
      }
    };

    syncMode();
    mobileQuery.addEventListener('change', syncMode);
  }
</script>

<style>
  .services-section {
    background-color: var(--color-warm-gray);
  }

  .services-header {
    max-width: 640px;
    margin-bottom: var(--space-16);
  }

  /* section-headline inherits navy from global — correct for light bg */

  .services-divider {
    width: 36px;
    height: 1px;
    background-color: var(--color-gold);
    margin-block: var(--space-6);
  }

  .services-intro {
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 580px;
    font-style: italic;
  }

  :lang(zh) .services-intro {
    font-family: var(--font-zh-sans);
    font-style: normal;
  }

  /* Grid — cards stay dark for strong contrast against the warm-gray section */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .service-card {
    background-color: var(--color-navy);
    padding: var(--space-10);
    position: relative;
    overflow: hidden;
    transition: background-color 180ms ease;
  }

  .service-card:hover {
    background-color: var(--color-navy-mid);
  }

  /* Ghost number */
  .service-number {
    position: absolute;
    top: var(--space-6);
    right: var(--space-8);
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 400;
    color: var(--color-gold);
    opacity: 0.1;
    line-height: 1;
    user-select: none;
    pointer-events: none;
  }

  .service-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-off-white);
    margin-bottom: var(--space-4);
    position: relative;
    z-index: 1;
  }

  :lang(zh) .service-title {
    font-family: var(--font-zh-serif);
  }

  .service-body {
    font-size: 0.88rem;
    line-height: 1.75;
    color: rgba(248, 246, 241, 0.6);
    position: relative;
    z-index: 1;
  }

  :lang(zh) .service-body {
    font-family: var(--font-zh-sans);
  }

  .services-mobile-steps {
    display: none;
  }

  .services-mobile-flow {
    --mobile-card-height: 320px;
    --mobile-bar-h: 44px;
  }

  /* ── Mobile-only elements: hidden by default ── */
  .mobile-section-bar,
  .card-mobile-top,
  .card-rule,
  .card-pips {
    display: none;
  }

  @media (max-width: 640px) {
    .services-header {
      padding-top: var(--space-8);
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      padding: var(--space-8) var(--space-6);
    }

    .card-mobile-top {
      display: flex;
      align-items: center;
      margin-bottom: var(--space-4);
    }

    .card-counter {
      font-size: 0.58rem;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-gold);
      opacity: 0.85;
    }

    :lang(zh) .card-counter {
      letter-spacing: 0.1em;
    }

    .card-rule {
      display: block;
      width: 28px;
      height: 1px;
      background-color: var(--color-gold);
      opacity: 0.4;
      margin: 0 0 var(--space-5);
    }

    .card-pips {
      display: flex;
      align-items: center;
      gap: 7px;
      margin-top: var(--space-8);
    }

    .card-pip {
      display: inline-block;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background-color: rgba(248, 246, 241, 0.2);
      transition: background-color 280ms ease, width 280ms ease, border-radius 280ms ease;
    }

    .card-pip.is-current {
      background-color: var(--color-gold);
      width: 20px;
      border-radius: 2.5px;
    }

    /* ── Sticky context bar ── */
    .mobile-section-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: var(--mobile-bar-h, 44px);
      padding: 0 var(--space-6);
      position: sticky;
      top: var(--header-height);
      z-index: 4;
      background-color: var(--color-warm-gray);
      border-bottom: 1px solid rgba(201, 168, 76, 0.25);
    }

    .mobile-bar-label {
      font-size: 0.58rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-navy);
      opacity: 0.5;
    }

    :lang(zh) .mobile-bar-label {
      letter-spacing: 0.08em;
    }

    .mobile-bar-counter {
      display: none;
    }

    /* ── Mobile flow: sticky card carousel ── */
    .services-mobile-flow.is-mobile-flow {
      position: relative;
    }

    .services-mobile-flow.is-mobile-flow .services-grid {
      display: block;
      position: sticky;
      top: max(
        calc(var(--header-height) + var(--mobile-bar-h, 44px) + var(--space-3)),
        calc((100svh - var(--mobile-card-height) + var(--header-height) + var(--mobile-bar-h, 44px)) / 2)
      );
      height: var(--mobile-card-height);
      border: none;
      background: transparent;
      z-index: 3;
    }

    /* ── Card: premium left-border design ── */
    .services-mobile-flow.is-mobile-flow .service-card {
      position: absolute;
      inset: 0;
      background: var(--color-navy);
      border: 1px solid rgba(201, 168, 76, 0.15);
      border-left: 3px solid var(--color-gold);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      opacity: 0;
      pointer-events: none;
      transition: opacity 280ms ease;
    }

    /* Hide the desktop ghost number on mobile */
    .services-mobile-flow.is-mobile-flow .service-number {
      display: none;
    }

    /* Override title padding (no ghost number to avoid) */
    .services-mobile-flow.is-mobile-flow .service-title {
      padding-right: 0;
      margin-bottom: var(--space-4);
      font-size: 1.15rem;
    }

    .services-mobile-flow.is-mobile-flow .service-body {
      font-size: 0.88rem;
      line-height: 1.72;
    }

    /* ── Card states ── */
    .services-mobile-flow.is-mobile-flow .service-card.is-active {
      opacity: 1;
      pointer-events: auto;
      z-index: 2;
    }

    /* ── Scroll anchor steps ── */
    .services-mobile-flow.is-mobile-flow .services-mobile-steps {
      display: block;
      position: relative;
      z-index: 1;
      padding-top: var(--mobile-card-height);
      margin-top: var(--space-2);
    }

    .services-mobile-flow.is-mobile-flow .services-mobile-step {
      height: clamp(96px, 14svh, 136px);
    }

    .services-mobile-flow.is-mobile-flow .services-mobile-step:last-child {
      height: clamp(76px, 11svh, 112px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-mobile-flow.is-mobile-flow .service-card {
      transition: opacity 150ms ease;
    }
  }
</style>
