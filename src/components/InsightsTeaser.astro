---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entries = await getCollection('insights', ({ data }) => data.lang === lang);
const latest = [...entries].sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)[0];

const label = lang === 'zh' ? '洞察' : 'Insights';
const cta = lang === 'zh' ? '阅读全文 →' : 'Read the article →';
---

{latest && (
  <section id="insights" class="section insights-teaser">
    <div class="container">
      <span class="section-label">{label}</span>
      <a class="insights-teaser-card" href={`/${lang}/insights/${latest.data.slug}/`}>
        <span class="insights-teaser-title">{latest.data.title}</span>
        <p class="insights-teaser-desc">{latest.data.description}</p>
        <span class="insights-teaser-cta" aria-hidden="true">{cta}</span>
      </a>
    </div>
  </section>
)}

<style>
  .insights-teaser {
    background-color: var(--color-warm-gray);
  }

  .insights-teaser-card {
    display: block;
    max-width: 720px;
    margin-top: var(--space-6);
    background-color: var(--color-off-white);
    border: 1px solid var(--color-border);
    padding: var(--space-8);
    transition: border-color 180ms ease;
  }

  .insights-teaser-card:hover {
    border-color: var(--color-gold);
  }

  .insights-teaser-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-navy);
    margin-bottom: var(--space-3);
  }

  :lang(zh) .insights-teaser-title {
    font-family: var(--font-zh-serif);
  }

  .insights-teaser-desc {
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  :lang(zh) .insights-teaser-desc {
    font-family: var(--font-zh-sans);
  }

  .insights-teaser-cta {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-gold);
  }
</style>
