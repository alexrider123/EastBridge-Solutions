---
import type { Translation } from '../i18n/en';
import type { Lang } from '../i18n/utils';

type ExperienceItem = Translation['experience']['items'][number];

interface Props {
  t: Translation;
  lang: Lang;
  item: ExperienceItem;
  prevItem: ExperienceItem | null;
  nextItem: ExperienceItem | null;
}

const { t, lang, item, prevItem, nextItem } = Astro.props;
const casesHref = `/${lang}/cases/`;
const backLabel = lang === 'zh' ? '← 返回所有案例' : '← Back to all case studies';
---

<section class="section case-detail">
  <div class="container">
    <a href={casesHref} class="case-back">{backLabel}</a>

    <header class="case-header">
      <span class="section-label">{t.experience.label}</span>
      <h1 class="section-headline">{item.sector}</h1>
      <div class="divider"></div>
    </header>

    <div class="case-card">
      <div class="case-card-body">
        <div class="case-col case-col--client">
          <span class="case-col-label">{t.experience.fieldLabels.profile}</span>
          <p class="case-col-text">{item.profile}</p>
        </div>
        <div class="case-col case-col--engagement">
          <span class="case-col-label">{t.experience.fieldLabels.engagement}</span>
          <p class="case-col-text">{item.body}</p>
        </div>
        <div class="case-col case-col--outcome">
          <span class="case-col-label">{t.experience.fieldLabels.outcome}</span>
          <p class="case-outcome-text">{item.outcome}</p>
        </div>
      </div>
    </div>

    <nav class="case-pager" aria-label="More case studies">
      {prevItem ? (
        <a class="case-pager-link case-pager-prev" href={`/${lang}/cases/${prevItem.slug}/`}>
          <span class="case-pager-arrow" aria-hidden="true">←</span>
          <span class="case-pager-text">{prevItem.sector}</span>
        </a>
      ) : <span />}
      {nextItem ? (
        <a class="case-pager-link case-pager-next" href={`/${lang}/cases/${nextItem.slug}/`}>
          <span class="case-pager-text">{nextItem.sector}</span>
          <span class="case-pager-arrow" aria-hidden="true">→</span>
        </a>
      ) : <span />}
    </nav>
  </div>
</section>

<style>
  .case-detail {
    background-color: var(--color-off-white);
  }

  .case-back {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-10);
    transition: color 180ms ease;
  }

  .case-back:hover {
    color: var(--color-gold);
  }

  .case-header {
    max-width: 700px;
    margin-bottom: var(--space-10);
  }

  .case-card {
    background-color: var(--color-navy);
  }

  .case-card-body {
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr;
  }

  .case-col {
    padding: var(--space-12) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .case-col--engagement,
  .case-col--outcome {
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .case-col-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(248, 246, 241, 0.45);
    flex-shrink: 0;
  }

  .case-col-text {
    font-size: 1rem;
    line-height: 1.9;
    color: rgba(248, 246, 241, 0.8);
    margin: 0;
  }

  :lang(zh) .case-col-text {
    font-family: var(--font-zh-sans);
  }

  .case-outcome-text {
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.75;
    color: var(--color-gold);
    margin: 0;
    white-space: pre-line;
  }

  :lang(zh) .case-outcome-text {
    font-family: var(--font-zh-sans);
  }

  .case-pager {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-12);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-8);
  }

  .case-pager-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.85rem;
    color: var(--color-navy);
    transition: color 180ms ease;
    max-width: 45%;
  }

  .case-pager-next {
    margin-left: auto;
    text-align: right;
    justify-content: flex-end;
  }

  .case-pager-link:hover {
    color: var(--color-gold);
  }

  .case-pager-arrow {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .case-card-body {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
    }

    .case-col--client { grid-column: 1; grid-row: 1; }
    .case-col--outcome { grid-column: 2; grid-row: 1; }
    .case-col--engagement {
      grid-column: 1 / -1;
      grid-row: 2;
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
  }

  @media (max-width: 560px) {
    .case-card-body {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .case-col--client, .case-col--outcome {
      grid-column: auto;
      grid-row: auto;
      border-left: none;
    }

    .case-col--outcome {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .case-col--engagement {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .case-pager {
      flex-direction: column;
    }

    .case-pager-link,
    .case-pager-next {
      max-width: 100%;
    }
  }
</style>
