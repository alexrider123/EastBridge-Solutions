---
import type { Translation } from '../i18n/en';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const [, ...restBody] = t.about.body;
---

<section id="about" class="about-section">
  <div class="container">
    <div class="about-core section">
      <header class="about-header">
        <span class="section-label">{t.about.label}</span>
        <h2 class="section-headline">{t.about.headline}</h2>
        <div class="divider"></div>
      </header>

      <div class="about-story">
        <div class="about-rest">
          {restBody.map((para) => (
            <p class="about-para">{para}</p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background-color: var(--color-off-white);
    border-top: 1px solid rgba(36, 48, 68, 0.08);
    border-bottom: 1px solid rgba(36, 48, 68, 0.08);
  }

  .about-core {
    display: grid;
    grid-template-columns: minmax(280px, 0.82fr) minmax(0, 1.58fr);
    gap: clamp(var(--space-8), 3.2vw, var(--space-16));
    align-items: center;
  }

  :lang(zh) .about-core {
    grid-template-columns: minmax(280px, 1.05fr) minmax(0, 1.35fr);
  }

  .about-header {
    max-width: 520px;
  }

  .about-story {
    border-left: 1px solid rgba(201, 168, 76, 0.4);
    padding-left: var(--space-10);
    max-width: 760px;
  }

  .about-rest {
    display: grid;
    gap: var(--space-6);
  }

  .about-para {
    font-size: 0.95rem;
    line-height: 1.82;
    color: var(--color-text-body);
    margin: 0;
  }

  :lang(zh) .about-para {
    font-family: var(--font-zh-sans);
    font-size: 0.94rem;
  }

  @media (max-width: 980px) {
    .about-core {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      align-items: start;
    }

    .about-header {
      max-width: 700px;
    }

    .about-story {
      max-width: 100%;
    }
  }

  @media (max-width: 720px) {
    .about-story {
      padding-left: var(--space-5);
    }
  }
</style>
