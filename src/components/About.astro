---
import type { Translation } from '../i18n/en';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const [, ...restBody] = t.about.body;
const mainParas = restBody.slice(0, -1);
const founderPara = restBody[restBody.length - 1];
---

<section id="about" class="about-section">
  <div class="container">
    <div class="about-core section">
      <header class="about-header">
        <span class="section-label">{t.about.label}</span>
        <h2 class="section-headline">{t.about.headline}</h2>
        <div class="divider"></div>
      </header>

      <div class="about-story">
        <div class="about-rest">
          {mainParas.map((para) => (
            <p class="about-para">{para}</p>
          ))}

          <!-- Desktop: plain paragraph. Mobile: collapsible under "Founder" label -->
          <div class="about-collapse" data-about-collapse>
            <button class="about-collapse-btn" type="button" aria-expanded="false">
              <span class="about-collapse-label">{t.founder.label}</span>
              <span class="about-collapse-icon" aria-hidden="true">+</span>
            </button>
            <div class="about-collapse-body">
              <p class="about-para">{founderPara}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background-color: var(--color-off-white);
    border-top: 1px solid rgba(36, 48, 68, 0.08);
    border-bottom: 1px solid rgba(36, 48, 68, 0.08);
  }

  .about-core {
    display: grid;
    grid-template-columns: minmax(280px, 0.82fr) minmax(0, 1.58fr);
    gap: clamp(var(--space-8), 3.2vw, var(--space-16));
    align-items: center;
  }

  :lang(zh) .about-core {
    grid-template-columns: minmax(280px, 1.05fr) minmax(0, 1.35fr);
  }

  .about-header {
    max-width: 520px;
  }

  .about-story {
    border-left: 1px solid rgba(201, 168, 76, 0.4);
    padding-left: var(--space-10);
    max-width: 760px;
  }

  .about-rest {
    display: grid;
    gap: var(--space-6);
  }

  .about-para {
    font-size: 0.95rem;
    line-height: 1.82;
    color: var(--color-text-body);
    margin: 0;
  }

  :lang(zh) .about-para {
    font-family: var(--font-zh-sans);
    font-size: 0.94rem;
  }

  /* Desktop: collapse button hidden, paragraph always visible */
  .about-collapse-btn {
    display: none;
  }

  .about-collapse-body {
    /* always visible on desktop */
  }

  @media (max-width: 980px) {
    .about-core,
    :lang(zh) .about-core {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      align-items: start;
    }

    .about-header {
      max-width: 700px;
    }

    .about-story {
      max-width: 100%;
    }

    /* Mobile: show toggle button */
    .about-collapse-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      background: none;
      border: none;
      border-top: 1px solid rgba(36, 48, 68, 0.1);
      padding: var(--space-4) 0;
      cursor: pointer;
      text-align: left;
    }

    .about-collapse-label {
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-navy);
      opacity: 0.6;
    }

    :lang(zh) .about-collapse-label {
      letter-spacing: 0.08em;
    }

    .about-collapse-icon {
      font-size: 1rem;
      font-weight: 300;
      color: var(--color-gold);
      line-height: 1;
      transition: transform 0.3s ease;
      flex-shrink: 0;
    }

    .about-collapse.is-open .about-collapse-icon {
      transform: rotate(45deg);
    }

    /* Mobile: paragraph hidden by default, reveals on open */
    .about-collapse-body {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease;
    }

    .about-collapse.is-open .about-collapse-body {
      max-height: 400px;
    }
  }

  @media (max-width: 720px) {
    .about-story {
      padding-left: var(--space-5);
    }
  }
</style>

<script>
  const collapse = document.querySelector<HTMLElement>('[data-about-collapse]');
  if (collapse && window.matchMedia('(max-width: 980px)').matches) {
    const btn = collapse.querySelector<HTMLButtonElement>('.about-collapse-btn');
    btn?.addEventListener('click', () => {
      const isOpen = collapse.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  }
</script>
