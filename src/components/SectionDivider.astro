<div class="section-divider" aria-hidden="true">
  <span></span>
</div>

<style>
  .section-divider {
    position: relative;
    height: 1px;
    background-color: var(--color-border);
  }

  .section-divider span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-gold);
    transform: translate(-50%, -50%);
  }
</style>
