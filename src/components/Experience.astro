---
import type { Translation } from '../i18n/en';
import type { Lang } from '../i18n/utils';

interface Props {
  t: Translation;
  lang: Lang;
}

const { t, lang } = Astro.props;
const teaserItems = t.experience.items.filter((item) => item.active).slice(0, 4);
const viewAllLabel = lang === 'zh' ? '查看全部案例研究 →' : 'View all case studies →';
---

<section id="experience" class="section experience-section">
  <div class="container">

    <div class="exp-header">
      <span class="section-label">{t.experience.label}</span>
      <h2 class="section-headline">{t.experience.headline}</h2>
      <div class="divider"></div>
      <p class="exp-intro">{t.experience.intro}</p>
    </div>

    <div class="exp-teaser-grid">
      {teaserItems.map((item) => (
        <a class="exp-teaser-card" href={`/${lang}/cases/${item.slug}/`}>
          <span class="exp-teaser-sector">{item.sector}</span>
          <p class="exp-teaser-outcome">{item.outcome}</p>
          <span class="exp-teaser-cta" aria-hidden="true">
            {lang === 'zh' ? '查看详情 →' : 'Read more →'}
          </span>
        </a>
      ))}
    </div>

    <div class="exp-view-all">
      <a href={`/${lang}/cases/`} class="exp-view-all-link">{viewAllLabel}</a>
    </div>

  </div>
</section>

<style>
  /* ─── Section ─── */
  .experience-section {
    background-color: var(--color-off-white);
  }

  .exp-header {
    max-width: 580px;
    margin-bottom: var(--space-12);
  }

  .exp-intro {
    font-size: 0.87rem;
    color: var(--color-text-muted);
    font-style: italic;
    line-height: 1.65;
  }

  :lang(zh) .exp-intro {
    font-family: var(--font-zh-sans);
    font-style: normal;
  }

  /* ─── Teaser grid ─── */
  .exp-teaser-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .exp-teaser-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background-color: var(--color-navy);
    padding: var(--space-8) var(--space-6);
    transition: background-color 180ms ease;
  }

  .exp-teaser-card:hover {
    background-color: var(--color-navy-mid);
  }

  .exp-teaser-sector {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-off-white);
    line-height: 1.3;
  }

  :lang(zh) .exp-teaser-sector {
    font-family: var(--font-zh-serif);
  }

  .exp-teaser-outcome {
    font-size: 0.82rem;
    line-height: 1.65;
    color: rgba(248, 246, 241, 0.65);
    flex: 1;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  :lang(zh) .exp-teaser-outcome {
    font-family: var(--font-zh-sans);
  }

  .exp-teaser-cta {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-gold);
  }

  .exp-view-all {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  .exp-view-all-link {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-navy);
    border-bottom: 1px solid var(--color-gold);
    padding-bottom: 2px;
    transition: color 180ms ease;
  }

  .exp-view-all-link:hover {
    color: var(--color-gold);
  }

  @media (max-width: 860px) {
    .exp-teaser-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .exp-teaser-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
