---
import type { Translation } from '../i18n/en';
import type { Lang } from '../i18n/utils';

interface Props {
  t: Translation;
  lang: Lang;
}

const { t, lang } = Astro.props;

// Curated order for the homepage teaser only — independent of
// t.experience.items' own order, which also drives the case-detail
// pages' prev/next pager.
const teaserOrderBySlug = ['industrial-manufacturing', 'publicly-traded-medical-group', 'automotive-ev-technology'];
const activeItems = t.experience.items.filter((item) => item.active);
const teaserItems = teaserOrderBySlug
  .map((slug) => activeItems.find((item) => item.slug === slug))
  .filter((item): item is (typeof activeItems)[number] => Boolean(item));
const viewAllLabel = lang === 'zh' ? '查看全部案例研究 →' : 'View all case studies →';
const swipeHint = lang === 'zh' ? '← 左右滑动 →' : '← swipe →';
---

<section id="experience" class="section experience-section">
  <div class="container">

    <div class="exp-header">
      <span class="section-label">{t.experience.label}</span>
      <h2 class="section-headline">{t.experience.headline}</h2>
      <div class="divider"></div>
      <p class="exp-intro">{t.experience.intro}</p>
    </div>

    <div class="exp-teaser-grid">
      {teaserItems.map((item) => (
        <a class="exp-teaser-card" href={`/${lang}/cases/${item.slug}/`}>
          <span class="exp-teaser-sector">{item.sector}</span>
          <p class="exp-teaser-outcome">{item.outcome}</p>
          <span class="exp-teaser-cta" aria-hidden="true">
            {lang === 'zh' ? '查看详情 →' : 'Read more →'}
          </span>
        </a>
      ))}
    </div>

    <p class="exp-swipe-hint" aria-hidden="true">{swipeHint}</p>

    <div class="exp-view-all">
      <a href={`/${lang}/cases/`} class="exp-view-all-link">{viewAllLabel}</a>
    </div>

  </div>
</section>

<style>
  /* ─── Section ─── */
  .experience-section {
    background-color: var(--color-off-white);
  }

  .exp-header {
    max-width: 580px;
    margin-bottom: var(--space-12);
  }

  .exp-intro {
    font-size: 0.87rem;
    color: var(--color-text-muted);
    font-style: italic;
    line-height: 1.65;
  }

  :lang(zh) .exp-intro {
    font-family: var(--font-zh-sans);
    font-style: normal;
  }

  /* ─── Teaser grid: 3 larger cards on desktop ─── */
  .exp-teaser-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .exp-teaser-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background-color: var(--color-navy);
    padding: var(--space-12) var(--space-8);
    transition: background-color 180ms ease;
  }

  .exp-teaser-card:hover {
    background-color: var(--color-navy-mid);
  }

  .exp-teaser-sector {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-off-white);
    line-height: 1.35;
  }

  :lang(zh) .exp-teaser-sector {
    font-family: var(--font-zh-serif);
  }

  .exp-teaser-outcome {
    font-size: 0.94rem;
    line-height: 1.8;
    color: rgba(248, 246, 241, 0.7);
    flex: 1;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  :lang(zh) .exp-teaser-outcome {
    font-family: var(--font-zh-sans);
  }

  .exp-teaser-cta {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-gold);
  }

  .exp-swipe-hint {
    display: none;
  }

  .exp-view-all {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  .exp-view-all-link {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-navy);
    border-bottom: 1px solid var(--color-gold);
    padding-bottom: 2px;
    transition: color 180ms ease;
  }

  .exp-view-all-link:hover {
    color: var(--color-gold);
  }

  /* ─── Mobile/tablet: horizontal swipe row instead of stacking ─── */
  @media (max-width: 820px) {
    .exp-teaser-grid {
      display: flex;
      gap: var(--space-3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      background-color: transparent;
      border: none;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--section-pad-h));
      padding-inline: var(--section-pad-h);
      padding-bottom: 2px;
    }

    .exp-teaser-grid::-webkit-scrollbar {
      display: none;
    }

    .exp-teaser-card {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }

    .exp-swipe-hint {
      display: block;
      text-align: center;
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      color: var(--color-text-muted);
      margin-top: var(--space-4);
    }
  }

  @media (max-width: 480px) {
    .exp-teaser-card {
      flex-basis: 88%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-teaser-grid {
      scroll-behavior: auto;
    }
  }
</style>
