---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  entries: CollectionEntry<'insights'>[];
}

const { lang, entries } = Astro.props;
const sorted = [...entries].sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const headline = lang === 'zh' ? '洞察' : 'Insights';
const intro =
  lang === 'zh'
    ? '关于中以商务往来的长篇分析与实务观察。'
    : 'Long-form analysis and field notes on China–Israel business engagement.';
---

<section class="section insights-index">
  <div class="container">
    <header class="insights-index-header">
      <span class="section-label">{headline}</span>
      <h1 class="section-headline">{headline}</h1>
      <div class="divider"></div>
      <p class="insights-index-intro">{intro}</p>
    </header>

    <ul class="insights-list">
      {sorted.map((entry) => (
        <li class="insights-list-item">
          <a class="insights-list-link" href={`/${lang}/insights/${entry.data.slug}/`}>
            <time class="insights-list-date" datetime={entry.data.publishDate.toISOString()}>
              {entry.data.publishDate.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <span class="insights-list-title">{entry.data.title}</span>
            <p class="insights-list-desc">{entry.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .insights-index {
    background-color: var(--color-off-white);
  }

  .insights-index-header {
    max-width: 640px;
    margin-bottom: var(--space-12);
  }

  .insights-index-intro {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-style: italic;
    line-height: 1.7;
  }

  :lang(zh) .insights-index-intro {
    font-family: var(--font-zh-sans);
    font-style: normal;
  }

  .insights-list {
    display: grid;
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
    max-width: 760px;
  }

  .insights-list-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background-color: var(--color-off-white);
    padding: var(--space-8);
    transition: background-color 180ms ease;
  }

  .insights-list-link:hover {
    background-color: var(--color-warm-gray);
  }

  .insights-list-date {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .insights-list-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-navy);
  }

  :lang(zh) .insights-list-title {
    font-family: var(--font-zh-serif);
  }

  .insights-list-desc {
    font-size: 0.87rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  :lang(zh) .insights-list-desc {
    font-family: var(--font-zh-sans);
  }
</style>
