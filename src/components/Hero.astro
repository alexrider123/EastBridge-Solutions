---
import type { Translation } from '../i18n/en';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<section class="hero" aria-label="Introduction">
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="hero-eyebrow">East Bridge Solutions</p>
      <div class="divider-line"></div>
      <h1 class="hero-headline">{t.hero.headline}</h1>
      <p class="hero-sub">{t.hero.subheadline}</p>
      <div class="hero-cta-group">
        <a href="#contact" class="hero-cta">{t.hero.cta}</a>
        <span class="hero-cta-sep" aria-hidden="true"></span>
        <a href="#experience" class="hero-cta--ghost">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero-geo" aria-hidden="true">
      <div class="geo-circle geo-circle--outer"></div>
      <div class="geo-circle geo-circle--inner"></div>
      <div class="geo-dot"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-navy);
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  /* Subtle background texture */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 60% at 70% 50%, rgba(201, 168, 76, 0.04) 0%, transparent 70%),
      radial-gradient(ellipse 40% 80% at 0% 50%, rgba(46, 61, 85, 0.6) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--space-24);
    position: relative;
    z-index: 1;
  }

  .hero-content {
    max-width: 680px;
  }

  /* Eyebrow */
  .hero-eyebrow {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-6);
  }

  :lang(zh) .hero-eyebrow {
    letter-spacing: 0.12em;
  }

  /* Gold divider */
  .divider-line {
    width: 40px;
    height: 1px;
    background-color: var(--color-gold);
    margin-bottom: var(--space-8);
    opacity: 0.7;
  }

  /* Headline */
  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.18;
    color: var(--color-off-white);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-8);
  }

  :lang(zh) .hero-headline {
    font-family: var(--font-zh-serif);
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  /* Sub */
  .hero-sub {
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.75;
    color: rgba(248, 246, 241, 0.65);
    max-width: 560px;
    margin-bottom: var(--space-12);
  }

  :lang(zh) .hero-sub {
    font-family: var(--font-zh-sans);
    font-size: 1rem;
  }

  /* CTA group */
  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  /* Primary CTA */
  .hero-cta {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid rgba(201, 168, 76, 0.5);
    padding: 0.75rem 2rem;
    transition: all 200ms ease;
  }

  :lang(zh) .hero-cta {
    letter-spacing: 0.06em;
  }

  .hero-cta:hover {
    background-color: var(--color-gold);
    color: var(--color-navy);
    border-color: var(--color-gold);
  }

  /* Vertical separator */
  .hero-cta-sep {
    display: inline-block;
    width: 1px;
    height: 1rem;
    background-color: rgba(201, 168, 76, 0.3);
    flex-shrink: 0;
  }

  /* Secondary CTA — typographic link style */
  .hero-cta--ghost {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(248, 246, 241, 0.45);
    background-image: linear-gradient(rgba(201, 168, 76, 0.5), rgba(201, 168, 76, 0.5));
    background-size: 0% 1px;
    background-position: left bottom 0;
    background-repeat: no-repeat;
    padding-bottom: 2px;
    transition: color 220ms ease, background-size 220ms ease;
  }

  :lang(zh) .hero-cta--ghost {
    letter-spacing: 0.06em;
  }

  .hero-cta--ghost::after {
    content: ' →';
    display: inline-block;
    transition: transform 220ms ease;
    font-style: normal;
  }

  .hero-cta--ghost:hover {
    color: rgba(248, 246, 241, 0.85);
    background-size: 100% 1px;
  }

  .hero-cta--ghost:hover::after {
    transform: translateX(4px);
  }

  /* Geometric decoration */
  .hero-geo {
    position: relative;
    width: 220px;
    height: 220px;
    flex-shrink: 0;
  }

  .geo-circle {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(201, 168, 76, 0.18);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .geo-circle--outer {
    width: 220px;
    height: 220px;
  }

  .geo-circle--inner {
    width: 140px;
    height: 140px;
    border-color: rgba(201, 168, 76, 0.12);
  }

  .geo-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-gold);
    opacity: 0.6;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-geo {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-headline {
      font-size: clamp(1.6rem, 6vw, 2rem);
    }

    .hero-sub {
      font-size: 0.95rem;
    }

    .hero-cta-group {
      flex-wrap: nowrap;
      gap: var(--space-3);
      align-items: center;
    }

    .hero-cta {
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      padding: 0.65rem 0.9rem;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .hero-cta-sep {
      background-color: rgba(201, 168, 76, 0.55);
      height: 1rem;
    }

    .hero-cta--ghost {
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      white-space: nowrap;
    }
  }
</style>
