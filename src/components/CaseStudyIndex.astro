---
import type { Translation } from '../i18n/en';
import type { Lang } from '../i18n/utils';

interface Props {
  t: Translation;
  lang: Lang;
}

const { t, lang } = Astro.props;
const items = t.experience.items.filter((item) => item.active);
---

<section class="section cases-index">
  <div class="container">
    <header class="cases-index-header">
      <span class="section-label">{t.experience.label}</span>
      <h1 class="section-headline">{t.experience.headline}</h1>
      <div class="divider"></div>
      <p class="cases-index-intro">{t.experience.intro}</p>
    </header>

    <ul class="cases-list">
      {items.map((item) => (
        <li class="cases-list-row">
          <a class="cases-list-link" href={`/${lang}/cases/${item.slug}/`}>
            <span class="cases-list-sector">{item.sector}</span>
            <span class="cases-list-outcome">{item.outcome}</span>
            <span class="cases-list-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cases-index {
    background-color: var(--color-off-white);
  }

  .cases-index-header {
    max-width: 640px;
    margin-bottom: var(--space-12);
  }

  .cases-index-intro {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-style: italic;
    line-height: 1.7;
  }

  :lang(zh) .cases-index-intro {
    font-family: var(--font-zh-sans);
    font-style: normal;
  }

  /* ─── Directory list: hairline-divided rows ─── */
  .cases-list {
    border-top: 1px solid var(--color-border);
  }

  .cases-list-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-10);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-border);
    transition: padding-left 180ms ease;
  }

  .cases-list-link:hover {
    padding-left: var(--space-3);
  }

  .cases-list-link:hover .cases-list-sector {
    color: var(--color-gold);
  }

  .cases-list-sector {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-navy);
    flex: 0 0 270px;
    transition: color 180ms ease;
  }

  :lang(zh) .cases-list-sector {
    font-family: var(--font-zh-serif);
  }

  .cases-list-outcome {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :lang(zh) .cases-list-outcome {
    font-family: var(--font-zh-sans);
  }

  .cases-list-arrow {
    font-size: 0.9rem;
    color: var(--color-gold);
    flex-shrink: 0;
  }

  @media (max-width: 700px) {
    .cases-list-link {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      position: relative;
    }

    .cases-list-link:hover {
      padding-left: 0;
    }

    .cases-list-sector {
      flex: none;
      padding-right: var(--space-8);
    }

    .cases-list-outcome {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      line-height: 1.7;
      padding-right: var(--space-8);
    }

    .cases-list-arrow {
      position: absolute;
      top: var(--space-8);
      right: 0;
    }
  }
</style>
