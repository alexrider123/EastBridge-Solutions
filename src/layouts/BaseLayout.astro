---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Translation } from '../i18n/en';
import type { Lang } from '../i18n/utils';

interface Props {
  t: Translation;
  lang: Lang;
  title?: string;
  description?: string;
  /** Path segment after the /en/ or /zh/ prefix (e.g. '' for home, 'cases/foo/'). */
  path?: string;
  /** Page-specific structured data, merged alongside the site-wide Organization schema. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { t, lang, title, description, path = '', jsonLd } = Astro.props;
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'East Bridge Solutions',
  url: 'https://eastbridge.solutions',
  logo: 'https://eastbridge.solutions/favicon.svg',
};

const jsonLdBlocks = [organizationJsonLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={t.meta.ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />

    <link rel="alternate" hreflang="en" href={`/en/${path}`} />
    <link rel="alternate" hreflang="zh" href={`/zh/${path}`} />
    <link rel="alternate" hreflang="x-default" href={`/en/${path}`} />
    <link rel="canonical" href={`https://eastbridge.solutions/${lang}/${path}`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- Google Fonts — preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&family=Noto+Serif+SC:wght@400;500;600&family=Noto+Sans+SC:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>
  </head>
  <body>
    <Header t={t} lang={lang} />
    <main>
      <slot />
    </main>
    <Footer t={t} />
    <!-- 100% privacy-first analytics -->
    <script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
  </body>
</html>
