---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudyIndex from '../../../components/CaseStudyIndex.astro';
import { zh } from '../../../i18n/zh';

const t = zh;
const pageTitle = '案例研究 | 东桥咨询';
